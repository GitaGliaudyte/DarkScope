{
  "manifest_version": 3,
  "name": "DarkScope",
  "version": "1.0.0",
  "description": "Dark pattern detector for Chrome.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>", "https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/crosshair.png",
      "32": "icons/crosshair.png",
      "48": "icons/crosshair.png",
      "128": "icons/crosshair.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
